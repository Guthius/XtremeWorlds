<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>2.4.9</Version>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <RootNamespace>XtremeWorlds.Client</RootNamespace>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <OutputPath>..\..\Build\Client\</OutputPath>
    <DefineConstants>CLIENT</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseSharedCompilation>false</UseSharedCompilation>
    <AssemblyName>XtremeWorlds.Client</AssemblyName>
    <Title>XtremeWorlds Client</Title>
    <Product>Game Client</Product>
  </PropertyGroup>

  <!-- Windows Host -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <!-- macOS -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT' and $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))">
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier> 
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  
  <!-- Linux Host -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT' and $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))">
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- Manifest/Install properties (usually only applies to Windows builds/targets) -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <ManifestCertificateThumbprint>181BBD77C201FB969E61DF100063FD42A08B2BE6</ManifestCertificateThumbprint>
    <TargetZone>LocalIntranet</TargetZone>
    <SignManifests>false</SignManifests>
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <UpdateEnabled>false</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <UpdatePeriodically>false</UpdatePeriodically>
    <UpdateRequired>false</UpdateRequired>
    <ApplicationRevision>1</ApplicationRevision>
    <ApplicationVersion>1.0.0.%2a</ApplicationVersion>
    <UseApplicationTrust>false</UseApplicationTrust>
    <PublishWizardCompleted>true</PublishWizardCompleted>
    <AssemblyTitle>XtremeWorlds.Client</AssemblyTitle>
  </PropertyGroup>
  
  <!-- Content files inclusion based on host OS -->
  <ItemGroup>
    <Content Include="Content\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Content\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- Windows -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Content Include="*.dll;*.sf2">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>False</Visible>
    </Content>
    <!-- Explicitly remove files not used on Windows just in case -->
    <None Remove="*.so;*.so.*;*.dylib" />
    <Content Remove="*.so;*.so.*;*.dylib" />
  </ItemGroup>

  <!-- macOS or Linux -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <Content Include="*.sf2">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>False</Visible>
    </Content>
    <!-- Exclude Windows DLLs -->
    <None Remove="*.dll" />
    <Content Remove="*.dll" />
  </ItemGroup>
  
  <!-- macOS -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT' and $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))">
    <Content Include="*.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>False</Visible>
    </Content>
    <None Remove="*.so;*.so.*" />
    <Content Remove="*.so;*.so.*" />
  </ItemGroup>

  <!-- Linux Host (Specific native library inclusion) -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT' and $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))">
    <Content Include="*.so;*.so.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>False</Visible>
    </Content>
    <None Remove="*.dylib" />
    <Content Remove="*.dylib" />
  </ItemGroup>

  <!-- Common resources (Keep as is) -->
  <ItemGroup>
    <Resource Include="Icon.bmp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Content\Skins\Crystashire.cs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

  <!-- Always include Eto.Forms, but only include platform-specific backends based on TFM resolution -->
  <ItemGroup>
    <PackageReference Include="Eto.Forms" />
  </ItemGroup>

  <!-- Windows-only backends (require -windows TFM) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="Eto.Platform.Wpf" />
    <PackageReference Include="Eto.Platform.Windows" />
    <PackageReference Include="ImeSharp" />
    <PackageReference Include="NVorbis" />
  </ItemGroup>

  <!-- Non-Windows backends: Gtk for Linux always; Mac64 only when explicitly enabled -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Eto.Platform.Gtk" />
    <!-- You likely need Eto.Platform.Mac64 here too if building on Mac -->
    <!-- <PackageReference Include="Eto.Platform.Mac64" /> -->
  </ItemGroup>

  <!-- Other platform-agnostic and always-needed packages -->
  <ItemGroup>
    <PackageReference Include="ManagedBass" />
    <PackageReference Include="ManagedBass.Midi" />
    <PackageReference Include="CS-Script" />
    <Reference Include="FNA">
      <HintPath>FNA.dll</HintPath>
    </Reference>
  </ItemGroup>
  
  <!-- Targets customized for the host OS -->
  <Target Name="EnsureContentFolderExists" BeforeTargets="Build">
    <MakeDir Directories="$(OutputPath)Content" />
  </Target>

  <!-- macOS: adjust dylib dependency paths so libFNA3D loads local libSDL3.dylib -->
  <Target Name="FixMacDylibRpaths" AfterTargets="Build" Condition="'$(OS)' != 'Windows_NT' and $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))">
    <Message Importance="high" Text="Fixing macOS dylib references in $(OutputPath)" />
    <!-- Note: Paths like /opt/homebrew might need adjusting if your build machine is different -->
    <Exec Command="/usr/bin/install_name_tool -change /opt/homebrew/opt/sdl3/lib/libSDL3.0.dylib @loader_path/libSDL3.0.dylib &quot;$(OutputPath)libFNA3D.dylib&quot;" ContinueOnError="true" />
  </Target>

  <!-- Ensure only one SDL3 dylib in output: keep libSDL3.0.dylib and replace plain libSDL3.dylib with a symlink -->
  <Target Name="NormalizeSDL3" AfterTargets="Build" Condition="'$(OS)' != 'Windows_NT' and $([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))">
    <Message Importance="high" Text="Normalizing SDL3 dylib filenames in $(OutputPath)" />
    <Exec Command="/bin/rm -f &quot;$(OutputPath)libSDL3.dylib&quot;" ContinueOnError="true" />
    <Exec WorkingDirectory="$(OutputPath)" Command="/bin/ln -sf libSDL3.0.dylib libSDL3.dylib" ContinueOnError="true" />
  </Target>

  <!-- Kill locking processes with robust success handling (skip in CI) -->
  <Target Name="KillLockingProcesses" BeforeTargets="BeforeBuild" Condition="'$(CI)' != 'true' and '$(SkipProcessKill)' != 'true' and '$(OS)' == 'Windows_NT'">
    <Exec Command="cmd /c tasklist | findstr /I $(AssemblyName).exe &gt;nul &amp;&amp; taskkill /F /IM $(AssemblyName).exe || exit /b 0" />
    <Exec Command="cmd /c tasklist | findstr /I dotnet.exe &gt;nul &amp;&amp; taskkill /F /IM dotnet.exe || exit /b 0" />
  </Target>
</Project>
