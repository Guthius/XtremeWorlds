<?xml version="1.0" encoding="utf-8"?>
<Window Name="winResourceEditor" Caption="Resource Editor"
	Size="760, 580"
        Icon="590" IconOffset="3, 5"
        Design="WindowNormal"
        StartPosition="CenterScreen"
        Visible="false">

	<!-- Left: Resource index list -->
	<GroupBox Name="grpList" Position="8,32" Size="200, 506" Caption="Resources">
		<ListBox Name="lstIndex" Position="8, 28" Size="170, 466"/>
		<ScrollBar Name="sldList" Position="178, 28" Size="16, 466" Min="0" Max="0" Value="0" Orientation="Vertical"/>
	</GroupBox>

	<!-- Right: Details -->
	<GroupBox Name="grpDetails" Position="212, 32" Size="536, 506" Caption="Details">
		<!-- Name / Messages -->
		<Label Name="lblName" Text="Name" Position="8, 28" Size="60, 16"/>
		<TextBox Name="txtName" Position="84, 24" Size="180, 20" Design="TextWhite"/>

		<Label Name="lblSuccess" Text="Success" Position="276, 28" Size="84, 16"/>
		<TextBox Name="txtMessage" Position="368,24" Size="156, 20" Design="TextWhite"/>

		<Label Name="lblEmpty" Text="Empty" Position="8, 64" Size="90, 16"/>
		<TextBox Name="txtMessage2" Position="84,60" Size="180, 20" Design="TextWhite"/>

		<!-- Type / Reward Item -->
		<Label Name="lblType" Text="Type" Position="272,64" Size="40, 16"/>
		<ComboBox Name="cmbType" Position="368,60" Size="156, 20"/>

		<Label Name="lblRewardItem" Text="Reward" Position="8, 100" Size="100, 16"/>
		<ComboBox Name="cmbRewardItem" Position="84,96" Size="180,20"/>

		<Label Name="lblRewardExp" Text="Exp" Position="272, 96" Size="100, 16"/>
		<TextBox Name="txtRewardExp" Position="368,96" Size="156, 16" Min="0" Max="1000000" Value="0" Orientation="Horizontal" ThumbSize="16"/>

		<!-- Tool / Animation -->
		<Label Name="lblTool" Text="Tool Req" Position="8, 136" Size="80, 16"/>
		<ComboBox Name="cmbTool" Position="84,132" Size="180, 20"/>

		<Label Name="lblAnimation" Text="Animation" Position="272,134" Size="90,16"/>
		<ComboBox Name="cmbAnimation" Position="368,132" Size="156,20"/>

		<!-- Health / Respawn -->
		<Label Name="lblHealth" Text="Health" Position="8, 172" Size="60, 16"/>
		<TextBox Name="txtHp" Position="84,168" Size="180, 16" Orientation="Horizontal" ThumbSize="16"/>
		<Label Name="lblHp" Text="0" Position="268,172" Size="40, 16"/>

		<Label Name="lblRespawn" Text="Respawn" Position="272,172" Size="72, 16"/>
		<TextBox Name="txtRespawn" Position="368,168" Size="156, 16" Orientation="Horizontal"/>
		<Label Name="lblRespawn" Text="0" Position="528,172" Size="32, 16"/>

		<!-- Level Required -->
		<Label Name="lblLvlReq" Text="Level Req" Position="8, 208" Size="80, 16"/>
		<ScrollBar Name="sldLvlReq" Position="84,204" Size="180, 16" Min="0" Max="255" Value="0" Orientation="Horizontal" ThumbSize="16"/>
		<Label Name="lblLvlReqVal" Text="0" Position="268,208" Size="40, 16"/>

		<!-- Normal / Exhausted Images -->
		<Label Name="lblNormalPic" Text="Sprite" Position="8,244" Size="72, 16"/>
		<ScrollBar Name="sldNormalPic" Position="84,240" Size="180, 16" Min="0" Max="0" Value="0" Orientation="Horizontal" ThumbSize="16"/>
		<Label Name="lblNormalPicVal" Text="0" Position="268,244" Size="40, 16"/>
		<PictureBox Name="picNormal" Position="84,260" Size="150,130"/>

		<Label Name="lblExhaustedPic" Text="Dead" Position="280, 238" Size="92, 16"/>
		<ScrollBar Name="sldExhaustedPic" Position="368,240" Size="156, 16" Min="0" Max="0" Value="0" Orientation="Horizontal" ThumbSize="16"/>
		<Label Name="lblExhaustedPicVal" Text="0" Position="528,244" Size="32, 16"/>
		<PictureBox Name="picExhausted" Position="368,260" Size="150,130"/>

		<!-- Common event trigger -->
		<Label Name="lblCommonEvent" Text="Event" Position="8, 426" Size="120,18"/>
		<ComboBox Name="cmbCommonEventType" Position="84, 424" Size="180,20"/>
		<Label Name="lblCommonEventData1" Text="Data 1" Position="276,426" Size="84,18"/>
		<TextBox Name="txtCommonEventData1" Position="368,424" Size="156,20" Design="TextWhite"/>
		<Label Name="lblCommonEventData2" Text="Data 2" Position="276,450" Size="84,18"/>
		<TextBox Name="txtCommonEventData2" Position="368,448" Size="156,20" Design="TextWhite"/>
	</GroupBox>

	<!-- Action buttons (centered at bottom like other editors) -->
	<Button Name="btnSave" Text="Save" Position="302, 546" Size="80, 24" Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>
	<Button Name="btnDelete" Text="Delete" Position="394, 546" Size="80, 24" Design="Red" DesignHover="RedHover" DesignMouseDown="RedClick"/>
	<Button Name="btnCopy" Text="Copy" Position="486, 546" Size="80, 24" Design="Orange" DesignHover="OrangeHover" DesignMouseDown="OrangeClick"/>
	<Button Name="btnCancel" Text="Cancel" Position="578, 546" Size="80, 24" Design="Red" DesignHover="RedHover" DesignMouseDown="RedClick"/>

	<!-- Close -->
	<Button Name="btnClose" Position="-19, 5" Size="16, 16" Image="8" ImageHover="9" ImageMouseDown="10"/>
</Window>