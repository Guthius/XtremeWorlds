<?xml version="1.0" encoding="utf-8"?>
<Window Name="winNpcEditor" Caption="Npc Editor"
    Size="720, 420"
        Icon="113" IconOffset="3, 5"
        Design="WindowNormal"
        StartPosition="CenterScreen"
        Visible="false">

  <!-- NPC index list on the left -->
  <Label Name="lblNpcList" Text="Npc" Position="16, 24" Size="80, 16"/>
  <ListBox Name="lstNpcs" Position="16, 44" Size="224, 366"/>
  <ScrollBar Name="sldNpcList" Position="240, 44" Size="16, 366" Min="0" Max="0" Vertical="true"/>

  <!-- Details group -->
  <GroupBox Name="grpNpcDetails" Caption="" Position="272, 32" Size="432, 348">
    <!-- Core fields -->
    <Label Name="lblNpcName" Text="Name" Position="8, 4" Size="80, 16"/>
    <TextBox Name="txtNpcName" Position="72, 2" Size="232, 20" Design="TextWhite"/>
    <Label Name="lblNpcAttackSay" Text="Attack Say" Position="8, 28" Size="100, 16"/>
    <TextBox Name="txtNpcAttackSay" Position="72, 26" Size="232, 20" Design="TextWhite"/>
    <Label Name="lblNpcBehavior" Text="Behavior" Position="8, 56" Size="80, 16"/>
    <ComboBox Name="cmbNpcBehavior" Position="72, 54" Size="120, 18"/>
    <Label Name="lblNpcSpawnPeriod" Text="Spawn" Position="8, 80" Size="70, 16"/>
    <ComboBox Name="cmbNpcSpawnPeriod" Position="72, 78" Size="120, 18"/>
    <Label Name="lblNpcAnimation" Text="Animation" Position="8, 104" Size="90, 16"/>
    <ComboBox Name="cmbNpcAnimation" Position="72, 102" Size="168, 18"/>
    <Label Name="lblNpcFaction" Text="Faction" Position="8, 128" Size="70, 16"/>
    <ComboBox Name="cmbNpcFaction" Position="72, 126" Size="168, 18"/>

    <!-- Sprite preview -->
    <PictureBox Name="picNpcSprite" Position="320, 4" Size="64, 64" Design="TextBlack"/>
    <Label Name="lblNpcSprite" Text="Sprite" Position="320, 72" Size="48, 16"/>
    <ScrollBar Name="sldNpcSprite" Position="320, 90" Size="96, 12" Min="0" Max="1" Value="0" Orientation="Horizontal" ThumbSize="16"/>

    <!-- Stats -->
    <Label Name="lblNpcHp" Text="HP" Position="8, 156" Size="40, 16"/>
    <TextBox Name="txtNpcHp" Position="48, 154" Size="80, 18" Design="TextWhite"/>
    <Label Name="lblNpcExp" Text="EXP" Position="8, 182" Size="40, 16"/>
    <TextBox Name="txtNpcExp" Position="48, 180" Size="80, 18" Design="TextWhite"/>
    <Label Name="lblNpcLevel" Text="Level" Position="8, 200" Size="60, 18"/>
    <TextBox Name="txtNpcLevel" Position="72, 200" Size="80, 18" Design="TextWhite"/>
    <Label Name="lblNpcDamage" Text="Damage" Position="168, 156" Size="60, 16"/>
    <TextBox Name="txtNpcDamage" Position="232, 154" Size="80, 18" Design="TextWhite"/>
    <Label Name="lblNpcRange" Text="Range" Position="168, 188" Size="60, 16"/>
    <ScrollBar Name="sldNpcRange" Position="232, 190" Size="160, 12" Min="0" Max="255" Value="0" Orientation="Horizontal" ThumbSize="12"/>

    <!-- Skills -->
    <Label Name="lblNpcSkills" Text="Skills" Position="8, 228" Size="60, 16"/>
    <ComboBox Name="cmbNpcSkill1" Position="72, 226" Size="160, 18"/>
    <ComboBox Name="cmbNpcSkill2" Position="252, 226" Size="156, 18"/>
    <ComboBox Name="cmbNpcSkill3" Position="72, 250" Size="160, 18"/>
    <ComboBox Name="cmbNpcSkill4" Position="252, 250" Size="156, 18"/>
    <ComboBox Name="cmbNpcSkill5" Position="72, 274" Size="160, 18"/>
    <ComboBox Name="cmbNpcSkill6" Position="252, 274" Size="156, 18"/>

    <!-- Drops -->
    <Label Name="lblNpcDrops" Text="Drops" Position="8, 300" Size="60, 16"/>
    <Label Name="lblNpcDropSlot" Text="Slot" Position="72, 300" Size="40, 16"/>
    <ComboBox Name="cmbNpcDropSlot" Position="112, 298" Size="60, 18"/>
    <Label Name="lblNpcDropItem" Text="Item" Position="180, 300" Size="40, 16"/>
    <ComboBox Name="cmbNpcDropItem" Position="224, 298" Size="184, 18"/>
    <Label Name="lblNpcAmount" Text="Amount" Position="8, 324" Size="60, 16"/>
    <TextBox Name="txtNpcAmount" Position="72, 322" Size="80, 18" Design="TextWhite"/>
    <Label Name="lblNpcChance" Text="Chance" Position="168, 324" Size="60, 16"/>
    <ScrollBar Name="sldNpcChance" Position="228, 322" Size="160, 12" Min="0" Max="100" Value="0" Orientation="Horizontal" ThumbSize="12"/>
  </GroupBox>

  <!-- Buttons centered directly under groupbox -->
  <Button Name="btnSave" Text="Save" Position="328, 388" Size="80, 24" Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>
  <Button Name="btnDelete" Text="Delete" Position="416, 388" Size="80, 24" Design="Red" DesignHover="RedHover" DesignMouseDown="RedClick"/>
  <Button Name="btnNpcCopy" Text="Copy" Position="504, 388" Size="80, 24" Design="Orange" DesignHover="OrangeHover" DesignMouseDown="OrangeClick"/>
  <Button Name="btnCancel" Text="Cancel" Position="592, 388" Size="80, 24" Design="Red" DesignHover="RedHover" DesignMouseDown="RedClick"/>

  <!-- Close button in title bar -->
  <Button Name="btnClose" Position="-19, 5" Size="16, 16" Image="8" ImageHover="9" ImageMouseDown="10"/>

</Window>
