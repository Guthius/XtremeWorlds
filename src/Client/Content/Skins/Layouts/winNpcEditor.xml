<?xml version="1.0" encoding="utf-8"?>
<Window Name="winNpcEditor" Caption="Npc Editor"
    Size="720, 430"
        Icon="113" IconOffset="3, 5"
        Design="WindowNormal"
        StartPosition="CenterScreen"
        Visible="false">

  <!-- NPC index list on the left -->
  <Label Name="lblNpcList" Text="Npc" Position="16, 24" Size="80, 16"/>
  <ListBox Name="lstNpcs" Position="16, 44" Size="224, 360"/>
  <ScrollBar Name="sldNpcList" Position="240, 44" Size="16, 360" Min="0" Max="0" Vertical="true"/>

  <!-- Parchment background for editor details (mirrors other Crystalshire editors) -->
  <PictureBox Name="picParchment" Position="272, 32" Size="432, 348" Image="Parchment" Design="Parchment"/>

  <!-- Core fields on the right (General group) -->
  <Label Name="lblNpcName" Text="Name" Position="280, 36" Size="80, 16"/>
  <TextBox Name="txtNpcName" Position="344, 34" Size="232, 20" Design="TextWhite"/>

  <Label Name="lblNpcAttackSay" Text="Attack Say" Position="280, 60" Size="100, 16"/>
  <TextBox Name="txtNpcAttackSay" Position="344, 58" Size="232, 20" Design="TextWhite"/>

  <Label Name="lblNpcBehavior" Text="Behavior" Position="280, 88" Size="80, 16"/>
  <ComboBox Name="cmbNpcBehavior" Position="344, 86" Size="120, 18"/>

  <Label Name="lblNpcSpawnPeriod" Text="Spawn" Position="280, 112" Size="70, 16"/>
  <ComboBox Name="cmbNpcSpawnPeriod" Position="344, 110" Size="120, 18"/>

  <Label Name="lblNpcAnimation" Text="Animation" Position="280, 136" Size="90, 16"/>
  <ComboBox Name="cmbNpcAnimation" Position="344, 134" Size="168, 18"/>

  <Label Name="lblNpcFaction" Text="Faction" Position="280, 160" Size="70, 16"/>
  <ComboBox Name="cmbNpcFaction" Position="344, 158" Size="168, 18"/>                     

  <!-- Sprite preview -->
  <PictureBox Name="picNpcSprite" Position="592, 36" Size="64, 64" Design="TextBlack"/>
  <Label Name="lblNpcSprite" Text="Sprite" Position="592, 104" Size="48, 16"/>
  <ScrollBar Name="sldNpcSprite" Position="592, 122" Size="96, 12" Min="0" Max="1" Value="0" Orientation="Horizontal" ThumbSize="16"/>

  <!-- Stats group (shifted down to make room for sprite) -->
  <Label Name="lblNpcHp" Text="HP" Position="280, 188" Size="40, 16"/>
  <TextBox Name="txtNpcHp" Position="320, 186" Size="80, 18" Design="TextWhite"/>

  <Label Name="lblNpcExp" Text="EXP" Position="280, 214" Size="40, 16"/>
  <TextBox Name="txtNpcExp" Position="320, 212" Size="80, 18" Design="TextWhite"/>

  <Label Name="lblNpcLevel" Text="Level" Position="280, 232" Size="60, 18"/>
  <TextBox Name="txtNpcLevel" Position="344, 232" Size="80, 18" Design="TextWhite"/>

  <Label Name="lblNpcDamage" Text="Damage" Position="440, 188" Size="60, 16"/>
  <TextBox Name="txtNpcDamage" Position="504, 186" Size="80, 18" Design="TextWhite"/>

  <Label Name="lblNpcRange" Text="Range" Position="440, 220" Size="60, 16"/>
  <ScrollBar Name="sldNpcRange" Position="504, 222" Size="160, 12" Min="0" Max="255" Value="0" Orientation="Horizontal" ThumbSize="12"/>

  <!-- Skills group (shifted down a bit to follow stats) -->
  <Label Name="lblNpcSkills" Text="Skills" Position="280, 260" Size="60, 16"/>
  <ComboBox Name="cmbNpcSkill1" Position="344, 258" Size="160, 18"/>
  <ComboBox Name="cmbNpcSkill2" Position="524, 258" Size="156, 18"/>
  <ComboBox Name="cmbNpcSkill3" Position="344, 282" Size="160, 18"/>
  <ComboBox Name="cmbNpcSkill4" Position="524, 282" Size="156, 18"/>
  <ComboBox Name="cmbNpcSkill5" Position="344, 306" Size="160, 18"/>
  <ComboBox Name="cmbNpcSkill6" Position="524, 306" Size="156, 18"/>

  <!-- Drop configuration (nudged down slightly) -->
  <Label Name="lblNpcDrops" Text="Drops" Position="280, 332" Size="60, 16"/>
  <Label Name="lblNpcDropSlot" Text="Slot" Position="344, 332" Size="40, 16"/>
  <ComboBox Name="cmbNpcDropSlot" Position="384, 330" Size="60, 18"/>

  <Label Name="lblNpcDropItem" Text="Item" Position="452, 332" Size="40, 16"/>
  <ComboBox Name="cmbNpcDropItem" Position="496, 330" Size="184, 18"/>

  <Label Name="lblNpcAmount" Text="Amount" Position="280, 356" Size="60, 16"/>
  <TextBox Name="txtNpcAmount" Position="344, 354" Size="80, 18" Design="TextWhite"/>

  <Label Name="lblNpcChance" Text="Chance" Position="440, 356" Size="60, 16"/>
  <ScrollBar Name="sldNpcChance" Position="500, 354" Size="160, 12" Min="0" Max="100" Value="0" Orientation="Horizontal" ThumbSize="12"/>

  <!-- Buttons centered directly under parchment -->
  <Button Name="btnSave" Text="Save" Position="328, 384" Size="80, 24" Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>
  <Button Name="btnDelete" Text="Delete" Position="416, 384" Size="80, 24" Design="Red" DesignHover="RedHover" DesignMouseDown="RedClick"/>
  <Button Name="btnNpcCopy" Text="Copy" Position="504, 384" Size="80, 24" Design="Orange" DesignHover="OrangeHover" DesignMouseDown="OrangeClick"/>
  <Button Name="btnCancel" Text="Cancel" Position="592, 384" Size="80, 24" Design="Red" DesignHover="RedHover" DesignMouseDown="RedClick"/>

  <!-- Close button in title bar (like map editor) -->
  <Button Name="btnClose" Position="-19, 5" Size="16, 16" Image="8" ImageHover="9" ImageMouseDown="10"/>

</Window>
