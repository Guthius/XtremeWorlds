<?xml version="1.0" encoding="utf-8"?>
<Window Name="winNpcEditor" Caption="Npc Editor"
    Size="720, 424"
        Icon="113" IconOffset="3, 5"
        Design="WindowNormal"
        StartPosition="CenterScreen"
        Visible="false">

  <!-- Index list on the left -->
  <Label Name="lblList" Text="Npc" Position="16, 24" Size="80, 16"/>
  <ListBox Name="lstIndex" Position="16, 44" Size="224, 360"/>
  <ScrollBar Name="sldList" Position="240, 44" Size="16, 360" Min="0" Max="0" Vertical="true"/>

  <!-- Details group -->
  <GroupBox Name="grpNpcDetails" Caption="" Position="272, 32" Size="432, 348">
    <!-- Core fields -->
    <Label Name="lblName" Text="Name" Position="8, 4" Size="80, 16"/>
    <TextBox Name="txtName" Position="72, 2" Size="232, 20" Design="TextWhite"/>
    <Label Name="lblAttackSay" Text="Attack Say" Position="8, 28" Size="100, 16"/>
    <TextBox Name="txtAttackSay" Position="72, 26" Size="232, 20" Design="TextWhite"/>
    <Label Name="lblBehavior" Text="Behavior" Position="8, 56" Size="80, 16"/>
    <ComboBox Name="cmbBehavior" Position="72, 54" Size="120, 18"/>
    <Label Name="lblSpawnPeriod" Text="Spawn" Position="8, 80" Size="70, 16"/>
    <ComboBox Name="cmbSpawnPeriod" Position="72, 78" Size="120, 18"/>
    <Label Name="lblAnimation" Text="Animation" Position="8, 104" Size="90, 16"/>
    <ComboBox Name="cmbAnimation" Position="72, 102" Size="168, 18"/>
    <Label Name="lblFaction" Text="Faction" Position="8, 128" Size="70, 16"/>
    <ComboBox Name="cmbFaction" Position="72, 126" Size="168, 18"/>

    <!-- Sprite preview -->
    <PictureBox Name="picSprite" Position="320, 4" Size="64, 64" Design="TextBlack"/>
    <Label Name="lblSprite" Text="Sprite" Position="270, 70" Size="54, 16"/>
    <ScrollBar Name="sldSprite" Position="320, 70" Size="96, 12" Min="0" Max="1" Value="0" Orientation="Horizontal" ThumbSize="16"/>

    <!-- Stats -->
    <Label Name="lblHp" Text="HP" Position="8, 156" Size="40, 16"/>
    <TextBox Name="txtHp" Position="48, 154" Size="80, 18" Design="TextWhite"/>
    <Label Name="lblExp" Text="EXP" Position="8, 182" Size="40, 16"/>
    <TextBox Name="txtExp" Position="48, 180" Size="80, 18" Design="TextWhite"/>
    <Label Name="lblLevel" Text="Level" Position="8, 200" Size="60, 18"/>
    <TextBox Name="txtLevel" Position="72, 200" Size="80, 18" Design="TextWhite"/>
    <Label Name="lblDamage" Text="Damage" Position="168, 156" Size="60, 16"/>
    <TextBox Name="txtDamage" Position="232, 154" Size="80, 18" Design="TextWhite"/>
    <Label Name="lblRange" Text="Range" Position="168, 188" Size="60, 16"/>
    <ScrollBar Name="sldRange" Position="232, 190" Size="160, 12" Min="0" Max="255" Value="0" Orientation="Horizontal" ThumbSize="12"/>

    <!-- Skills -->
    <Label Name="lblSkills" Text="Skills" Position="8, 228" Size="60, 16"/>
    <ComboBox Name="cmbSkill1" Position="72, 226" Size="160, 18"/>
    <ComboBox Name="cmbSkill2" Position="252, 226" Size="156, 18"/>
    <ComboBox Name="cmbSkill3" Position="72, 250" Size="160, 18"/>
    <ComboBox Name="cmbSkill4" Position="252, 250" Size="156, 18"/>
    <ComboBox Name="cmbSkill5" Position="72, 274" Size="160, 18"/>
    <ComboBox Name="cmbSkill6" Position="252, 274" Size="156, 18"/>

    <!-- Drops -->
    <Label Name="lblDrops" Text="Drops" Position="8, 300" Size="60, 16"/>
    <Label Name="lblDropSlot" Text="Slot" Position="72, 300" Size="40, 16"/>
    <ComboBox Name="cmbDropSlot" Position="112, 298" Size="60, 18"/>
    <Label Name="lblDropItem" Text="Item" Position="180, 300" Size="40, 16"/>
    <ComboBox Name="cmbDropItem" Position="224, 298" Size="184, 18"/>
    <Label Name="lblAmount" Text="Amount" Position="0, 324" Size="60, 16"/>
    <TextBox Name="txtAmount" Position="72, 322" Size="80, 18" Design="TextWhite"/>
    <Label Name="lblChance" Text="Chance" Position="168, 324" Size="60, 16"/>
    <ScrollBar Name="sldChance" Position="228, 322" Size="160, 12" Min="0" Max="100" Value="0" Orientation="Horizontal" ThumbSize="12"/>
  </GroupBox>

  <!-- Buttons centered directly under groupbox -->
  <Button Name="btnSave" Text="Save" Position="328, 392" Size="80, 24" Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>
  <Button Name="btnDelete" Text="Delete" Position="416, 392" Size="80, 24" Design="Red" DesignHover="RedHover" DesignMouseDown="RedClick"/>
  <Button Name="btnCopy" Text="Copy" Position="504, 392" Size="80, 24" Design="Orange" DesignHover="OrangeHover" DesignMouseDown="OrangeClick"/>
  <Button Name="btnCancel" Text="Cancel" Position="592, 392" Size="80, 24" Design="Red" DesignHover="RedHover" DesignMouseDown="RedClick"/>

  <!-- Close button in title bar -->
  <Button Name="btnClose" Position="-19, 5" Size="16, 16" Image="8" ImageHover="9" ImageMouseDown="10"/>

</Window>
