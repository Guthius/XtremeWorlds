<?xml version="1.0" encoding="utf-8"?>
<Window Name="winAdmin" Caption="Admin Panel"
    Size="640, 260"
    Icon="970" IconOffset="3, 5"
    Design="WindowNormal"
    StartPosition="CenterScreen"
    Visible="false">

    <!-- Tab Control for different admin sections -->
    <GroupBox Name="grpAdmin" Position="6, 26" Size="624, 224">
        <!-- MODERATION TAB -->
        <GroupBox Name="grpModeration" Caption="Moderation">
            <!-- Player Name Section -->
            <Label Name="lblPlayerName" Text="Player Name:" Position="20, 55" Size="140, 12"/>
            <TextBox Name="txtName" Position="125, 53" Size="300, 18"/>

            <!-- Access Level Section -->
            <Label Name="lblAccessLevel" Text="Access Level:" Position="20, 80" Size="140, 12"/>
            <ComboBox Name="cmbAccess" Position="125, 78" Size="200, 18"/>
            <Button Name="btnSetAccess" Text="Set Access" Position="330, 78" Size="80, 22"
             Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>

            <!-- Map Number Section -->
            <Label Name="lblMapNumber" Text="Map Number:" Position="20, 105" Size="140, 12"/>
            <TextBox Name="txtAdminMap" Position="125, 103" Size="100, 18"/>
            <Button Name="btnWarpTo" Text="Warp To Map" Position="230, 103" Size="100, 22"
            Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>

             <!-- Sprite Section -->
            <Label Name="lblSprite" Text="Sprite:" Position="20, 130" Size="100, 12"/>
            <TextBox Name="txtSprite" Position="125, 128" Size="100, 18"/>
            <Button Name="btnSetSprite" Text="Set Sprite" Position="230, 128" Size="100, 22"
            Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>

            <!-- Action Buttons Row 1 -->
            <Button Name="btnBan" Text="Ban Player" Position="20, 158" Size="120, 22"
            Design="Red" DesignHover="RedHover" DesignMouseDown="RedClick"/>
            <Button Name="btnKick" Text="Kick Player" Position="145, 158" Size="120, 22"
            Design="Red" DesignHover="RedHover" DesignMouseDown="RedClick"/>
            <Button Name="btnLevelUp" Text="Level Up" Position="270, 158" Size="120, 22"
            Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>

            <!-- Action Buttons Row 2 -->
            <Button Name="btnWarp2Me" Text="Warp Player To Me" Position="20, 186" Size="145, 22"
            Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>
            <Button Name="btnWarpMe2" Text="Warp Me To Player" Position="170, 186" Size="145, 22"
            Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>
        </GroupBox>

        <!-- MAP LIST TAB -->
        <GroupBox Name="grpMapList" Caption="Maps">
            <ListBox Name="lstMaps" Position="25, 55" Size="586, 122"/>
            <ScrollBar Name="sldMapList" Position="611, 55" Size="12, 122" Orientation="Vertical" Min="0" Max="100" Value="0"/>
            <Button Name="btnMapWarp" Text="Warp" Position="25, 186" Size="220, 22"
            Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>
            <Button Name="btnMapReport" Text="Refresh List" Position="255, 186" Size="368, 22"
            Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>
        </GroupBox>

        <!-- MAP TOOLS TAB -->
        <GroupBox Name="grpMapTools" Caption="Map Tools">
            <Button Name="btnRespawn" Text="Respawn Map" Position="20, 55" Size="200, 22"
            Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>
            <Button Name="btnALoc" Text="Toggle Location Display" Position="225, 55" Size="200, 22"
            Design="Orange" DesignHover="OrangeHover" DesignMouseDown="OrangeClick"/>
        </GroupBox>

        <!-- EDITORS TAB -->
        <GroupBox Name="grpEditors" Caption="Editors">
            <!-- Editor Buttons Grid Row 1 -->
            <Button Name="btnAnimationEditor" Text="Animation" Position="25, 55" Size="140, 22"
            Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>
            <Button Name="btnJobEditor" Text="Job" Position="170, 55" Size="140, 22"
            Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>
            <Button Name="btnItemEditor" Text="Item" Position="315, 55" Size="140, 22"
            Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>
            <Button Name="btnMapEditor" Text="Map" Position="460, 55" Size="155, 22"
            Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>

            <!-- Editor Buttons Grid Row 2 -->
            <Button Name="btnNpcEditor" Text="Npc" Position="25, 82" Size="140, 22"
            Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>
            <Button Name="btnProjectiles" Text="Projectile" Position="170, 82" Size="140, 22"
            Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>
            <Button Name="btnResourceEditor" Text="Resource" Position="315, 82" Size="140, 22"
            Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>
            <Button Name="btnShopEditor" Text="Shop" Position="460, 82" Size="155, 22"
            Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>

            <!-- Editor Buttons Grid Row 3 -->
            <Button Name="btnSkillEditor" Text="Skill" Position="25, 109" Size="140, 22"
            Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>
            <Button Name="btnMoralEditor" Text="Moral" Position="170, 109" Size="140, 22"
            Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>
            <Button Name="btnScriptEditor" Text="Script" Position="315, 109" Size="140, 22"
            Design="Green" DesignHover="GreenHover" DesignMouseDown="GreenClick"/>
        </GroupBox>
    </GroupBox>
	
	<Button Name="btnClose" Position="-19, 5" Size="16, 16" Image="8" ImageHover="9" ImageMouseDown="10"/>
</Window>
