<?xml version="1.0" encoding="utf-8"?>
<Window Name="winNewChar" Caption="Create Character"
        Size="290, 172"
        Icon="17" IconOffset="2, 6"
        Design="WindowNormal"
        StartPosition="CenterScreen"
        Visible="False">

	<GroupBox Name="grpNewChar" Position="6, 26" Size="274, 136">
		<!-- Name -->
		<PictureBox Position="24, 21" Size="124, 9" Design="BlackOval"/>
		<Label Text="Name" Position="24, 18" Size="142, 10" Align="Center"/>

		<!-- Textbox -->
		<TextBox Name="txtName" Position="24, 34" Size="124, 19"/>

		<!-- Sex -->
		<PictureBox Position="24, 64" Size="124, 9" Design="BlackOval"/>
		<Label Text="Gender" Position="24, 61" Size="142, 10" Align="Center"/>
		<CheckBox Name="chkMale" Text="Male" Position="24, 82" Size="55, 15" Design="CheckboxNormal"/>
		<CheckBox Name="chkFemale" Text="Female" Position="85, 82" Size="62, 15" Design="CheckboxNormal"/>

		<!-- Buttons -->
		<Button Name="btnAccept" Text="Accept"
				Position="24, 106" Size="60, 24"
				Design="Green"
				DesignHover="GreenHover"
				DesignMouseDown="GreenClick"/>

		<Button Name="btnCancel" Text="Cancel"
				Position="88, 106" Size="60, 24"
				Design="Red"
				DesignHover="RedHover"
				DesignMouseDown="RedClick"/>

		<!-- Sprite -->
		<PictureBox Position="170, 21" Size="76, 9" Design="BlackOval"/>
		<Label Text="Sprite" Position="170, 18" Size="76, 10" Align="Center"/>

		<!-- Scene -->
		<PictureBox Name="picScene" Position="160, 34" Size="96, 96" Image="11"/>

		<!-- Buttons -->
		<Button Name="btnLeft" Position="158, 19" Size="10, 13" Image="12" ImageHover="14" ImageMouseDown="16"/>
		<Button Name="btnRight" Position="247, 19" Size="10, 13" Image="13" ImageHover="15" ImageMouseDown="17"/>
	</GroupBox>

	<Button Name="btnClose" Position="-19, 5" Size="16, 16" Image="8" ImageHover="9" ImageMouseDown="10"/>
</Window>