<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
	    <UseSharedCompilation>false</UseSharedCompilation>
	    <AssemblyTitle>XtremeWorlds.Core</AssemblyTitle>
	    <AssemblyName>XtremeWorlds.Core</AssemblyName>
	    <AssemblyRootSpace>XtremeWorlds.Core</AssemblyRootSpace>
		
        <!-- Ensure each target framework uses its own output/intermediate folders to prevent locking -->
        <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
        <AppendTargetFrameworkToIntermediateOutputPath>true</AppendTargetFrameworkToIntermediateOutputPath>
        <!-- Disable parallel build/node reuse for this project to avoid race locking in CI -->
        <BuildInParallel>false</BuildInParallel>
        <MSBuildDisableNodeReuse>true</MSBuildDisableNodeReuse>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CS-Script" />
        <PackageReference Include="CS-Script.Core" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Database\" />
    </ItemGroup>
</Project>
