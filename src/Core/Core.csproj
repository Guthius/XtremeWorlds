<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup>
	    <UseSharedCompilation>false</UseSharedCompilation>
	    <AssemblyTitle>XtremeWorlds.Core</AssemblyTitle>
	    <AssemblyName>XtremeWorlds.Core</AssemblyName>
	    <AssemblyRootSpace>XtremeWorlds.Core</AssemblyRootSpace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CS-Script" />
        <PackageReference Include="CS-Script.Core" />
    </ItemGroup>

  <Target Name="KillLockingProcesses" BeforeTargets="BeforeBuild">
    <!-- Kill running app processes that commonly lock Core.dll during development -->
    <Exec Command="taskkill /F /IM XtremeWorlds.Client.exe" ContinueOnError="true" />
    <Exec Command="taskkill /F /IM XtremeWorlds.Server.exe" ContinueOnError="true" />
    <!-- Kill dotnet host if running this workspace's apps; best-effort -->
    <Exec Command="taskkill /F /IM dotnet.exe" ContinueOnError="true" />
  </Target>
</Project>
