{
  // Launch configurations for XtremeWorlds
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C# Server",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Server",
      "program": "${workspaceFolder}/Build/Server/Server.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Build/Server",
      "console": "integratedTerminal",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "C# Client",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Client",
      "program": "${workspaceFolder}/Build/Client/Client.dll",
      "args": [],
      "cwd": "${workspaceFolder}/Build/Client",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    }
    ,
    {
      "name": "C# Client (macOS .app, net9.0-macos, arm64)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Client",
      "program": "${workspaceFolder}/Build/Client/osx-arm64/Client.app/Contents/MacOS/Client",
      "args": [],
      "cwd": "${workspaceFolder}/Build/Client/osx-arm64",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    }
  ]
}
